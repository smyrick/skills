{
  "name": "smyrick-skills",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Personal agent skills library for Shane Myrick",
  "scripts": {
    "add-skill": "cd skills && npx skills init",
    "format": "node scripts/format-skills.js",
    "format:check": "node scripts/format-skills.js --check",
    "check": "npm run format:check && npm run validate && npm run test:contract",
    "validate": "node scripts/validate-skills.js",
    "test:contract": "node --test tests/*.test.js",
    "oci:package": "node scripts/package-oci.js",
    "oci:verify": "node scripts/verify-oci.js",
    "oci:smoke": "npm run oci:package && npm run oci:verify",
    "oci:publish": "node scripts/publish-oci.js",
    "oci:publish:dry-run": "node scripts/publish-oci.js --dry-run",
    "oci:release": "npm run check && npm run oci:smoke && npm run oci:publish",
    "check:skills": "node scripts/validate-skills.js skills",
    "check:openai": "node scripts/validate-skills.js openai",
    "check:claude": "node scripts/validate-skills.js claude",
    "check:policy": "node scripts/validate-skills.js policy",
    "check:package": "node scripts/validate-skills.js package",
    "check:parity": "node scripts/validate-skills.js parity",
    "check:plugins": "node scripts/validate-skills.js plugins",
    "build:targets": "node scripts/build-targets.js",
    "setup:spec": "uv sync --locked --project tools/skills-ref",
    "build:plugins": "node scripts/build-plugins.js",
    "plugin:package": "node scripts/package-plugins.js",
    "plugin:verify": "node scripts/verify-plugins.js"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "yaml": "^2.8.3"
  }
}
