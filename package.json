{
  "name": "smyrick-skills",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Personal agent skills library for Shane Myrick",
  "scripts": {
    "add-skill": "cd skills && npx skills init",
    "format": "node scripts/format-skills.js",
    "format:check": "node scripts/format-skills.js --check",
    "check": "npm run format:check && npm run validate",
    "validate": "node scripts/validate-skills.js",
    "oci:package": "node scripts/package-oci.js",
    "oci:publish": "node scripts/publish-oci.js",
    "oci:publish:dry-run": "node scripts/publish-oci.js --dry-run",
    "oci:release": "npm run check && npm run oci:package && npm run oci:publish"
  },
  "devDependencies": {
    "yaml": "^2.8.3"
  }
}
